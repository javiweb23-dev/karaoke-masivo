{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "mikaraokelatino.com"
        }
      ],
      "destination": "/ventas/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "karaokepro.live"
        }
      ],
      "destination": "/index.html"
    }
  ]
}